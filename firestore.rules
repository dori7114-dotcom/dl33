rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 개인정보 보호 마인드맵
    // 학생은 Firebase 익명 인증을 사용합니다.
    match /classes/{classId}/nodes/{nodeId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'type', 'text', 'parentId', 'createdAt', 'updatedAt', 'ownerUid'
        ])
        && request.resource.data.type in ['group', 'info', 'protect']
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 40
        && request.resource.data.parentId is string
        && request.resource.data.ownerUid == request.auth.uid;

      // 수정 시 text, updatedAt만 바꿀 수 있게 하여
      // 다른 조의 구조/작성 내용을 통째로 덮어쓰는 일을 막습니다.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['text', 'updatedAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 40;

      allow delete: if request.auth != null;
    }
  }
}
